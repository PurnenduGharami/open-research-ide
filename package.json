{
  "name": "open-research-ide",
  "version": "0.2.0",
  "private": true,
  "description": "A local-first, harness-agnostic Scientific Research IDE with grounded literature, independent review panels, multi-modal validation, and reproducible exports.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:fixture-ui": "node tests/ui-e2e.mjs",
    "preflight": "node scripts/preflight.mjs"
  },
  "dependencies": {
    "@openclaw/gateway-client": "2026.8.1",
    "@openclaw/gateway-protocol": "2026.8.1",
    "@xyflow/react": "13.0.2",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "playwright": "^1.58.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typebox": "^1.3.37",
    "ws": "^8.19.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "typescript": "5.9.3"
  }
}
