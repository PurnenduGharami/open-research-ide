# Server-only secrets. Never prefix these with NEXT_PUBLIC_.

# Execution runtime (zero external gateway required)
RESEARCH_HARNESS=standalone

# Default Google Gemini API preset (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
RESEARCH_PROVIDER=gemini
RESEARCH_MODEL=gemini-2.5-flash
RESEARCH_REVIEW_PROVIDER=gemini
RESEARCH_REVIEW_MODEL=gemini-2.5-flash
RESEARCH_AGENT_ID=research

# Optional Google Cloud Vertex AI configuration
VERTEX_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Optional Local Gemma (Ollama) or custom endpoint
# RESEARCH_BASE_URL=http://127.0.0.1:11434/v1
# CUSTOM_API_KEY=

# Optional literature API credentials (recommended to avoid public rate limits)
OPENALEX_MAILTO=
SEMANTIC_SCHOLAR_API_KEY=

RESEARCH_WORKSPACE=./workspace
PORT=3000
