# Server-only secrets. Never prefix these with NEXT_PUBLIC_.

# Execution harness: "openclaw" (default) or "standalone" (direct API, no external gateway required)
RESEARCH_HARNESS=openclaw

# Default OpenClaw + Cerebras preset
CEREBRAS_API_KEY=
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_HTTP_URL=http://127.0.0.1:18789

# Role models & providers (cerebras | openai-compatible | anthropic | gemini | openrouter | ollama)
RESEARCH_PROVIDER=cerebras
RESEARCH_MODEL=cerebras/moonshotai-kimi-k3.1-pro-trial
RESEARCH_REVIEW_PROVIDER=cerebras
RESEARCH_REVIEW_MODEL=cerebras/moonshotai-kimi-k3.1-pro-trial
RESEARCH_AGENT_ID=research

# Optional provider keys for standalone / multi-provider mode
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# RESEARCH_BASE_URL=http://127.0.0.1:11434/v1

# Optional literature API credentials (recommended to avoid public rate limits)
OPENALEX_MAILTO=
SEMANTIC_SCHOLAR_API_KEY=

RESEARCH_WORKSPACE=./workspace
PORT=3000
